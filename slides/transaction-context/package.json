{
	"name": "transaction-context-slides",
	"private": true,
	"type": "module",
	"devDependencies": {
		"@eslint/js": "9.39.1",
		"@slidev/cli": "53.0.0",
		"@slidev/theme-default": "0.25.0",
		"@types/node": "26.6.2",
		"eslint": "9.39.1",
		"eslint-config-prettier": "10.1.8",
		"globals": "16.4.0",
		"playwright-chromium": "^1.63.0",
		"prettier": "3.6.2",
		"typescript": "5.9.3",
		"typescript-eslint": "8.67.0",
		"vite": "8.3.4",
		"vitest": "4.1.7"
	},
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": "26.x"
	},
	"scripts": {
		"dev": "slidev slides.md --port 3030",
		"build": "pnpm run typecheck && slidev build slides.md --out dist",
		"export:pptx": "slidev export slides.md --format pptx --with-clicks false --dark --wait 1000 --output exports/事务上下文注入.pptx",
		"lint": "eslint .",
		"format": "prettier --write *.json *.ts *.mjs style.css",
		"format:check": "prettier --check *.json *.ts *.mjs style.css",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	}
}
