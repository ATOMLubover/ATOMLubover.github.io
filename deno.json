{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A npm:astro dev",
    "start": "deno task dev",
    "check": "deno run -A npm:astro check",
    "build": "deno run -A npm:astro build && deno run -A npm:pagefind --site dist",
    "preview": "deno run -A npm:astro preview",
    "astro": "deno run -A npm:astro",
    "new-post": "deno run --allow-read --allow-write scripts/new-post.js",
    "format": "deno run -A npm:@biomejs/biome format --write ./src",
    "lint": "deno run -A npm:@biomejs/biome check ./src"
  }
}
